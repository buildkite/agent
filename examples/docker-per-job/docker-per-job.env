# Settings for the docker-per-job hooks. Sourced by bash; keep it to plain
# assignments. Paths marked "same path" must be identical on the Docker host,
# in the agent's mount namespace, and in the job container, because jobs pass
# them to the host daemon in bind mounts.

# Image every job runs in. It needs bash, git and the docker CLI (see
# Dockerfile.job). The agent binary is mounted in, so the image doesn't need it.
BK_DPJ_IMAGE="buildkite-docker-per-job:latest"

# Must match the agent's --job-context-dir (same path).
BK_DPJ_CONTEXT_DIR="/var/lib/buildkite-agent/docker-per-job/context"

# Each job gets $BK_DPJ_JOBS_ROOT/<job id> for its checkout and sockets
# (same path). Everything else under here is deleted between jobs.
BK_DPJ_JOBS_ROOT="/var/lib/buildkite-agent/docker-per-job/jobs"

# Must match the agent's --build-path. kubernetes-bootstrap starts the
# bootstrap in this directory; Docker creates it in the job container.
BK_DPJ_BUILD_PATH="/var/lib/buildkite-agent/builds"

# Where POISONED is written when cleanup can't be confirmed.
BK_DPJ_STATE_DIR="/var/lib/buildkite-agent/docker-per-job"

# Linux buildkite-agent binary to mount into job containers.
BK_DPJ_AGENT_BINARY="/usr/bin/buildkite-agent"

# Host Docker socket given to job containers.
BK_DPJ_DOCKER_SOCKET="/var/run/docker.sock"

# Resources that survive between jobs. See keep.list.
BK_DPJ_KEEP_FILE="/etc/buildkite-agent/docker-per-job/keep.list"

# Optional: agent git mirrors path, mounted at the same path. Leave empty to
# disable.
BK_DPJ_GIT_MIRRORS_PATH=""

# Optional: extra `docker run` arguments for the job container, split on
# whitespace (for example "--network host" or "--cpus 4 --memory 8g").
BK_DPJ_EXTRA_RUN_ARGS=""
