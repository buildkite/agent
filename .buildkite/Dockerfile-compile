FROM public.ecr.aws/docker/library/golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc
COPY build/ssh.conf /etc/ssh/ssh_config.d/

COPY go-licenses-version /tmp/go-licenses-version
RUN go install "github.com/google/go-licenses@$(cat /tmp/go-licenses-version)"
# Ruby used for polyglot hook integration tests; python3 and zstd for test/cache-exec-e2e
RUN apt update && apt install -y ruby python3 zstd
