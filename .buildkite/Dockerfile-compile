FROM public.ecr.aws/docker/library/golang:1.26.10@sha256:5c3f3f28a273c9b61698b2d34f18375929790ab1f1d3835d032d21e2b31eae0c
COPY build/ssh.conf /etc/ssh/ssh_config.d/

COPY go-licenses-version /tmp/go-licenses-version
RUN go install "github.com/google/go-licenses@$(cat /tmp/go-licenses-version)"
# Ruby used for polyglot hook integration tests
RUN apt update && apt install -y ruby
